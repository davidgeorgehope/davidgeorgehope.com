---
const title = 'Blog — David George Hope';
const description = 'Notes on building things, mostly practical.';
const posts = [
  {
    href: '/blog/giving-grok-a-voice/',
    title: 'Give your Grok Bot a phone number',
    date: '26 August 2026',
    blurb: 'A number people can call, a receptionist Grok, and a webhook into the Grok Bot that already has your mail and calendar. Two signups. Step by step.',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://davidgeorgehope.com/blog/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://davidgeorgehope.com/blog/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>

      :root {
        --ink: #1a1f24;
        --ink-muted: #4a5560;
        --ink-soft: #6b7580;
        --paper: #f3f1ec;
        --paper-deep: #e8e4dc;
        --line: #d4cfc4;
        --accent: #1f5c4d;
        --accent-hover: #174539;
        --focus: #2563a8;
        --max: 42rem;
        --font-display: "Newsreader", Palatino, serif;
        --font-body: "Source Sans 3", "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.65;
        background: #f7f5f0;
      }
      a { color: var(--accent); text-underline-offset: 0.18em; }
      a:hover { color: var(--accent-hover); }
      .page { position: relative; z-index: 1; max-width: var(--max); margin: 0 auto; padding: 3.5rem 1.4rem 4rem; }
      .name { font-family: var(--font-display); font-size: 2.4rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.25rem; }
      .nav-links { display: flex; flex-wrap: wrap; gap: 0.9rem 1.2rem; list-style: none; padding: 0; margin: 0 0 2.4rem; border-bottom: 1px solid var(--line); padding-bottom: 1.1rem; }
      .section { margin-bottom: 2.4rem; }
      .section-title { font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 1rem; }
      .site-footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.9rem; }
      .lede { color: var(--ink-muted); margin: 0 0 1.4rem; }
      .meta { margin: 0.2rem 0 1.4rem; color: var(--ink-soft); font-size: 0.95rem; }
      .post-title { font-family: var(--font-display); font-size: 2rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.3rem; line-height: 1.2; }
      h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; margin: 2rem 0 0.7rem; }
      h3 { font-size: 1.05rem; margin: 1.4rem 0 0.4rem; }
      p { margin: 0 0 0.9rem; }
      ul, ol { margin: 0 0 1rem; padding-left: 1.25rem; }
      li { margin: 0 0 0.4rem; }
      .figure { margin: 1.2rem 0 1.5rem; }
      .figure img { display: block; width: 100%; height: auto; border-radius: 8px; background: #0b1c33; }
      .figure figcaption { margin-top: 0.55rem; color: var(--ink-soft); font-size: 0.9rem; }
      pre.prompt {
        margin: 0.6rem 0 1.1rem;
        padding: 0.95rem 1rem;
        background: var(--paper-deep);
        border: 1px solid var(--line);
        border-radius: 8px;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: 0.86rem;
        line-height: 1.5;
      }
      .note { color: var(--ink-muted); }
      .steps { list-style: decimal; }
      .steps > li { margin: 0 0 1.1rem; }

      .post-name { margin: 0; font-weight: 600; }
      .post-blurb { margin: 0.2rem 0 0; color: var(--ink-muted); }
      .post-list { list-style: none; padding: 0; margin: 0; }
      .post { margin: 0 0 1.2rem; }
    </style>
  </head>
  <body>
    <div class="page">
      <nav aria-label="Site">
        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </nav>
      <h1 class="post-title">Blog</h1>
      <p class="lede">One useful writeup at a time. No content mill.</p>
      <ul class="post-list">
        {posts.map((post) => (
          <li class="post">
            <p class="post-name"><a href={post.href}>{post.title}</a></p>
            <p class="meta">{post.date}</p>
            <p class="post-blurb">{post.blurb}</p>
          </li>
        ))}
      </ul>
      <footer class="site-footer"><p>davidgeorgehope.com</p></footer>
    </div>
  </body>
</html>
