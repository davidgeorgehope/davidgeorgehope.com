---
const title = 'David George Hope — Solutions Architect at SpaceX AI';
const description =
  'Solutions Architect at SpaceX AI. Formerly Director of Product Marketing for Observability at Elastic. Personal projects in observability, OpenTelemetry, and AI tooling.';

const projects = [
  { name: 'Vibecaster', href: 'https://vibecaster.ai', blurb: 'AI social media automation — generate, schedule, and post across X, LinkedIn, and YouTube.' },
  { name: 'Contractor Relief', href: 'https://contractorrelief.ai', blurb: 'AI voice and SMS agent that finds, qualifies, and follows up with local contractors.' },
  { name: 'Messaging Engine', href: 'https://msg.engineer', blurb: 'PMM workbench that turns practitioner pain points into scored, traceable messaging assets.' },
  { name: 'Shortest', href: 'https://livelabs.cc', blurb: 'Door-to-door route finder that ranks drive, transit, and flight options by leave-door to arrive-door time. Hosted on LiveLabs.' },
  { name: 'ducktel', href: 'https://github.com/davidgeorgehope/ducktel', blurb: 'Lightweight local OpenTelemetry backend — OTLP in, Parquet storage, SQL out for agent workflows.' },
  { name: 'Observability demos', href: 'https://github.com/davidgeorgehope/elastic-launch-demo', blurb: 'Demo generators and instrumentation examples around OpenTelemetry and SRE-style tooling.' },
  { name: 'Nox Voice', href: null, blurb: 'Two-way AI phone conversations over Twilio Media Streams and the OpenAI Realtime API.' },
  { name: 'CompIntels', href: 'https://compintels.com', blurb: 'AI-powered competitive intelligence for sales teams.' },
  { name: 'KidVid', href: 'https://github.com/davidgeorgehope/kidvid', blurb: 'Offline Android video player with a simple swipe interface, built as a personal project.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="David George Hope" />
    <link rel="canonical" href="https://davidgeorgehope.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://davidgeorgehope.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,500;6..72,600&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
    <style>
      :root {
        --ink: #1a1f24;
        --ink-muted: #4a5560;
        --ink-soft: #6b7580;
        --paper: #f3f1ec;
        --paper-deep: #e8e4dc;
        --line: #d4cfc4;
        --accent: #1f5c4d;
        --accent-hover: #174539;
        --focus: #2563a8;
        --max: 42rem;
        --font-display: "Newsreader", Palatino, serif;
        --font-body: "Source Sans 3", "Segoe UI", sans-serif;
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        font-family: var(--font-body);
        font-size: 1.0625rem;
        line-height: 1.65;
        background: #f7f5f0;
      }
      a { color: var(--accent); text-underline-offset: 0.18em; }
      a:hover { color: var(--accent-hover); }
      .page { position: relative; z-index: 1; max-width: var(--max); margin: 0 auto; padding: 3.5rem 1.4rem 4rem; }
      .name { font-family: var(--font-display); font-size: 2.4rem; font-weight: 600; letter-spacing: -0.02em; margin: 0 0 0.25rem; }
      .role { margin: 0; font-weight: 600; }
      .meta { margin: 0.35rem 0 0; color: var(--ink-soft); font-size: 0.95rem; }
      .summary { margin: 1.6rem 0 1.2rem; color: var(--ink-muted); }
      .summary p { margin: 0 0 0.85rem; }
      .nav-links { display: flex; flex-wrap: wrap; gap: 0.9rem 1.2rem; list-style: none; padding: 0; margin: 0 0 2.4rem; border-bottom: 1px solid var(--line); padding-bottom: 1.1rem; }
      .section { margin-bottom: 2.4rem; }
      .section-title { font-family: var(--font-display); font-size: 1.35rem; margin: 0 0 1rem; }
      .job { margin-bottom: 1.2rem; }
      .job-header { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
      .job-title { margin: 0; font-size: 1.05rem; font-weight: 600; }
      .job-org { font-weight: 700; }
      .job-when { margin: 0; color: var(--ink-soft); font-size: 0.9rem; }
      .job-detail { margin: 0.35rem 0 0; color: var(--ink-muted); }
      .project-list, .edu-list, .contact-list { list-style: none; padding: 0; margin: 0; }
      .project { margin: 0 0 1.05rem; }
      .project-name { margin: 0; font-weight: 600; }
      .project-blurb { margin: 0.2rem 0 0; color: var(--ink-muted); }
      .contact-label { display: inline-block; width: 5.5rem; color: var(--ink-soft); }
      .site-footer { margin-top: 2rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--ink-soft); font-size: 0.9rem; }
    </style>
  </head>
  <body>
    <div class="page">
      <header>
        <h1 class="name">David George Hope</h1>
        <p class="role">Solutions Architect at SpaceX AI</p>
        <p class="meta">New York · Cobblehurst · family outside of work</p>
        <div class="summary">
          <p>Solutions Architect at SpaceX AI, focused on practical systems that connect product, platform, and operations. Previously led product marketing for Observability at Elastic after earlier work as a sales engineer.</p>
          <p>Builds demo generators, instrumentation and observability tools, and personal projects around OpenTelemetry, AI-powered observability, SRE tooling, and small product experiments.</p>
        </div>
        <nav aria-label="Page sections">
          <ul class="nav-links">
            <li><a href="#experience">Experience</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="#education">Education</a></li>
            <li><a href="#contact">Contact</a></li>
          </ul>
        </nav>
      </header>
      <main>
        <section class="section" id="experience">
          <h2 class="section-title">Experience</h2>
          <article class="job">
            <div class="job-header">
              <h3 class="job-title">Solutions Architect · <span class="job-org">SpaceX AI</span></h3>
              <p class="job-when">Current</p>
            </div>
          </article>
          <article class="job">
            <div class="job-header">
              <h3 class="job-title">Director of Product Marketing, Observability · <span class="job-org">Elastic</span></h3>
              <p class="job-when">Past</p>
            </div>
            <p class="job-detail">Former sales engineer at Elastic.</p>
          </article>
        </section>
        <section class="section" id="projects">
          <h2 class="section-title">Selected projects</h2>
          <ul class="project-list">
            {projects.map((project) => (
              <li class="project">
                <p class="project-name">
                  {project.href ? <a href={project.href} rel="noopener noreferrer">{project.name}</a> : project.name}
                </p>
                <p class="project-blurb">{project.blurb}</p>
              </li>
            ))}
          </ul>
        </section>
        <section class="section" id="blog">
          <h2 class="section-title">Blog</h2>
          <ul class="project-list">
            <li class="project">
              <p class="project-name"><a href="/blog/giving-grok-a-voice/">Give your Grok Bot a phone number</a></p>
              <p class="project-blurb">A number people can call, a receptionist Grok, and a webhook into the Grok Bot that already has your mail and calendar. Two signups, numbered steps.</p>
            </li>
          </ul>
        </section>
        <section class="section" id="education">
          <h2 class="section-title">Education</h2>
          <ul class="edu-list"><li>Brunel University</li></ul>
        </section>
        <section class="section" id="contact">
          <h2 class="section-title">Contact</h2>
          <ul class="contact-list">
            <li><span class="contact-label">Email</span> <a href="mailto:email.djhope@gmail.com">email.djhope@gmail.com</a></li>
            <li><span class="contact-label">LinkedIn</span> <a href="https://www.linkedin.com/in/davidgeorgehope" rel="noopener noreferrer">linkedin.com/in/davidgeorgehope</a></li>
            <li><span class="contact-label">GitHub</span> <a href="https://github.com/davidgeorgehope" rel="noopener noreferrer">github.com/davidgeorgehope</a></li>
          </ul>
        </section>
      </main>
      <footer class="site-footer"><p>davidgeorgehope.com</p></footer>
    </div>
  </body>
</html>
